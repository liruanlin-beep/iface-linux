include *.md LICENSE CITATION.cff WINDOWS_BASELINE.json pyproject.toml install.sh
include requirements-tested.txt
include .gitattributes .gitignore
recursive-include app *.py *.json *.sh *.ico
recursive-include tests *.py
recursive-include tools *.py
recursive-include docs/screenshots *.png
recursive-include docs/validation *.json
include examples/Al/POSCAR
include .github/workflows/tests.yml
global-exclude __pycache__ *.py[cod] .DS_Store
prune .git
prune .venv
prune build
prune dist
prune config
prune projects
prune outputs
prune database
prune logs
